{
  "name": "didcomm-ts",
  "version": "0.1.0",
  "description": "Independent DIDComm v2 implementation in TypeScript: authcrypt/anoncrypt/signed messages, routing, mediation and pickup, interop-tested against didcomm-rust and didcomm-python",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./attestation": {
      "types": "./dist/attestation/index.d.ts",
      "import": "./dist/attestation/index.js"
    },
    "./provenance": {
      "types": "./dist/provenance/index.d.ts",
      "import": "./dist/provenance/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/chat",
    "README.md",
    "INTEROP.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "postbuild": "node -e \"require('fs').cpSync('src/chat/public','dist/chat/public',{recursive:true})\"",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc -p . --noEmit",
    "demo": "node scripts/demo.mjs",
    "start": "node dist/chat/cli.js serve",
    "interop:aviary": "npm --prefix test/interop/aviary ci && node test/interop/aviary/probe.mjs",
    "interop:live": "node scripts/live-interop.mjs --block-wasm",
    "prepublishOnly": "npm run build",
    "bench": "node scripts/bench.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writerslogic/didcomm-ts.git"
  },
  "homepage": "https://github.com/writerslogic/didcomm-ts#readme",
  "bugs": {
    "url": "https://github.com/writerslogic/didcomm-ts/issues"
  },
  "author": "Writerslogic",
  "keywords": [
    "didcomm",
    "did",
    "decentralized-identity",
    "ssi",
    "verifiable-credentials",
    "mediator",
    "did-peer"
  ],
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "cbor-x": "^1.5.9",
    "didcomm": "^0.4.1",
    "express": "^4.21.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.4"
  }
}
